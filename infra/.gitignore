node_modules
*.js
!jest.config.js
*.d.ts
# ...but a lambda's hand-written `runtime.d.ts` is SOURCE, not tsc output: it declares the
# `awslambda` response-streaming global. Without this negation the blanket rule silently
# drops it, and CI's fresh clone fails typecheck while local passes. Globbed across all
# lambdas rather than named one at a time — the ai-only version let the parse lambda repeat
# the exact failure this comment already described.
!lambda/**/runtime.d.ts
dist
cdk.out
.cdk.staging
*.local
